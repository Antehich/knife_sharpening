/*
 * Holyiot HOLYIOT-21011 v1.0: nRF52810-QFAA + LIS2DH12, CR2032.
 *
 * Пины взяты со схемы HOLYIOT-21014 V1.0 (2021/11/13), та же плата с RGB-светодиодом.
 * Для 21011 v1.0 независимо подтверждены кнопка P0.31 (активный высокий) и
 * светодиод P0.30 (активный низкий), а LIS2DH12 отвечал на P0.02/P0.05 с питанием от P0.08.
 *
 *   P0.02  SDI  (MOSI)          P0.06  INT1
 *   P0.03  SDO  (MISO / SA0)    P0.07  INT2
 *   P0.04  CS                   P0.08  LVCC: питание LIS2DH12 (VDD и VDD_IO)
 *   P0.05  SCK                  P0.30  LED (катод через 1 кОм, анод на VDD)
 *   P0.00/P0.01  кварц 32.768 кГц (если установлен)
 *   P0.31  KEY (кнопка на VDD, подтяжка 100 кОм к GND)
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <nordic/nrf52810_qfaa.dtsi>
#include "holyiot_21011-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Holyiot 21011";
	compatible = "holyiot,21011";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
			label = "Push button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};
	};

	zephyr,user {
		/* Питание акселерометра: высокий уровень включает LIS2DH12. */
		accel-power-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led0 = &led0;
		sw0 = &button0;
		accel0 = &lis2dh12;
	};
};

/*
 * DC/DC по умолчанию выключен (работает LDO). Если на плате у вывода DCC стоят
 * дроссели 10 мкГн и 15 нГн, DC/DC включается оверлеем boards/dcdc.overlay.
 * Включённый DC/DC без дросселей не даёт чипу работать.
 */

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	/* Фронты кнопки P0.31 ловятся механизмом SENSE (PORT event), а не каналом GPIOTE:
	 * канал GPIOTE в режиме event держит включённым тактирование и заметно ест ток.
	 */
	sense-edge-mask = <0x80000000>;
};

&adc {
	status = "okay";
};

&spi0 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;

	lis2dh12: lis2dh12@0 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0>;
		/* LIS2DH12 допускает до 10 МГц; 4 МГц с запасом для коротких дорожек. */
		spi-max-frequency = <4000000>;
		irq-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>, <&gpio0 7 GPIO_ACTIVE_HIGH>;
	};
};

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		/* Без загрузчика: образ с адреса 0 (так проще заливать .bin со смещением 0). */
		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00000000 0x0002e000>;
		};

		/* 8 КБ (2 страницы) под NVS/settings: там хранится калибровка. */
		storage_partition: partition@2e000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0002e000 0x00002000>;
		};
	};
};
