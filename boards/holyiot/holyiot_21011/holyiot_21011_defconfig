# 32 кГц: кварц 32.768 кГц на P0.00/P0.01. На 21011 v1.0 он установлен (проверено
# диагностикой, этап 0: «X1», 3215 тиков за 100 мс по RC-шкале). Допуск берём с запасом.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_50PPM=y

CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# Ни UART, ни RTT на плате нет.
CONFIG_SERIAL=n
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
CONFIG_RTT_CONSOLE=n
CONFIG_USE_SEGGER_RTT=n
