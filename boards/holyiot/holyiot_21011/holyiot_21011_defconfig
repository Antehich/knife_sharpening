# 32 кГц: по умолчанию внутренний RC-генератор (работает всегда).
# Кварц 32.768 кГц на схеме есть (P0.00/P0.01), но установлен ли он на 21011,
# проверяет диагностическая прошивка (этап 0). Если да, в prj.conf приложения
# можно переключить на CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# Ни UART, ни RTT на плате нет.
CONFIG_SERIAL=n
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
CONFIG_RTT_CONSOLE=n
CONFIG_USE_SEGGER_RTT=n
